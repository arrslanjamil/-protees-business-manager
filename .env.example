VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only (Vercel Environment Variables — NOT prefixed with VITE_) ---
# These are read only by /api/shopify-sync.ts and must never be added with a
# VITE_ prefix, or they would be bundled into the public browser JS.
# Set these in the Vercel dashboard: Project -> Settings -> Environment Variables.
#
# SUPABASE_SERVICE_ROLE_KEY=   (Supabase dashboard -> Project Settings -> API -> service_role)
# SHOPIFY_PROTEES_DOMAIN=      (e.g. protees.myshopify.com)
# SHOPIFY_PROTEES_TOKEN=       (Protees Admin API access token)
# SHOPIFY_LITTLE_PEANUTS_DOMAIN=   (e.g. little-peanuts.myshopify.com)
# SHOPIFY_LITTLE_PEANUTS_TOKEN=    (Little Peanuts Admin API access token)
# CRON_SECRET=                 (any random string — Vercel Cron sends this automatically once set, authorizing the scheduled sync)
