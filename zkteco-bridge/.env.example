# Same project as the main app — find these in Supabase → Settings → API.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security, which is correct
# here: this script has no logged-in app user, it authenticates as the
# server. Never put this key in the web app or commit it anywhere.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides — normally the device IP/port come from the
# zkteco_devices table (Settings → Attendance Settings in the app), so
# non-technical staff can update the IP without touching this file. Set
# these only to force a specific device instead of "first active one".
# DEVICE_IP=192.168.1.201
# DEVICE_PORT=4370
